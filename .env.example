# ==============================================================================
# LEAD EDGE MARKETING — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://leadedge.agency

# Email Provider Configuration (resend | sendgrid | smtp | mock)
# Set to 'mock' in local development to test without external keys
EMAIL_PROVIDER=mock
EMAIL_FROM="Lead Edge Website <notifications@leadedge.agency>"
EMAIL_TO="hello@leadedge.agency"

# Provider API Keys (Fill when client confirms provider - CIR-08)
RESEND_API_KEY=
SENDGRID_API_KEY=

# SMTP Configuration (Optional alternative)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Spam Protection (Optional Cloudflare Turnstile / hCaptcha)
CAPTCHA_SECRET_KEY=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
